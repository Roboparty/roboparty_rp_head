#!/usr/bin/make -f

INSTALL_PREFIX ?= /opt/roboparty

ROBOPARTY_DEP_PREFIX ?= $(INSTALL_PREFIX)

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=$(INSTALL_PREFIX) \
		-DCMAKE_PREFIX_PATH=$(ROBOPARTY_DEP_PREFIX) \
		-DCMAKE_BUILD_TYPE=Release

override_dh_auto_install:
	dh_auto_install
	install -d debian/roboparty-rp-head/usr/bin
	ln -sf $(INSTALL_PREFIX)/bin/roboparty-head debian/roboparty-rp-head/usr/bin/roboparty-head
